# Copy this file to .env and fill in your real values.
# Get API_KEY and API_SECRET by registering an app on Sharekhan's
# API developer portal (Partners App). Never commit the real .env file.

PORT=4000
FRONTEND_URL=http://localhost:5173

# --- Sharekhan app credentials ---
SHAREKHAN_API_KEY=
SHAREKHAN_API_SECRET=
SHAREKHAN_CUSTOMER_ID=
SHAREKHAN_VENDOR_KEY=
# Leave blank unless Sharekhan's developer portal explicitly assigned your
# app a Version ID. Only "" (blank), 1005, or 1006 are valid — anything
# else (including "1") causes a 400 Bad Request during token exchange.
SHAREKHAN_VERSION_ID=

# Base URL of Sharekhan's API — confirm against your developer portal,
# Sharekhan has had more than one API generation.
SHAREKHAN_BASE_URL=https://api.sharekhan.com

# Must exactly match the callback URL you registered on the developer portal.
SHAREKHAN_REDIRECT_URL=http://localhost:4000/api/auth/callback

# --- Safety switch: backtest-only phase ---
# Leave "false" (or unset) to block POST /api/orders/place before it ever
# reaches the Sharekhan SDK or network — historical data and scrip search
# still work normally either way. Only flip to "true" once you're
# deliberately ready to place a real order, and restart the backend after
# changing it (env vars are only read at process start / per-request from
# process.env, not hot-reloaded from the file).
ENABLE_LIVE_TRADING=false
